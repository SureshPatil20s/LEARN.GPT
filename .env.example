# ==============================================================================
# LEARN.GPT Backend — Environment Variables Template (.env.example)
# Configure these in your Render Web Service -> Environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Host Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
SECRET_KEY=generate_a_random_32_character_hex_secret_here

# ------------------------------------------------------------------------------
# 2. Database Connection (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase URI format (Direct or Session Pooler port 5432):
# postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. CORS Configuration
# ------------------------------------------------------------------------------
# Set to your primary deployed Vercel frontend URL (without trailing slash)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Optional comma-separated list of additional preview / custom domains
ADDITIONAL_CORS_ORIGINS=https://your-preview-branch.vercel.app,https://yourdomain.com

# ------------------------------------------------------------------------------
# 4. AI Provider API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key (Free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq LPU API Key (Free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (Optional image generation: https://huggingface.co/settings/tokens)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 5. Authentication & OAuth
# ------------------------------------------------------------------------------
# Optional Google Client ID for backend token validation
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
